# Application Settings
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Datadog APM / Observability
# dd-trace sends traces to a Datadog Agent.
# Transport priority (auto-detected by server.js):
#   1. DD_TRACE_AGENT_URL — explicit override (e.g. unix:///var/run/datadog/apm.socket)
#   2. Unix Domain Socket at /var/run/datadog/apm.socket if the file exists (AKS DaemonSet)
#   3. TCP fallback to DD_AGENT_HOST:DD_AGENT_PORT (default localhost:8126)
# Set DD_TRACE_ENABLED=false to disable tracing entirely in local dev.
DD_TRACE_ENABLED=false
DD_ENV=development
DD_SERVICE=self-service-infra
DD_AGENT_HOST=localhost
DD_AGENT_PORT=8126
# DD_SITE is used by the dashboard deploy workflow — matches your Datadog org region.
DD_SITE=us3.datadoghq.com

# GitHub authentication: use a fine-grained token or configure the GitHub App below
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional GitHub App Configuration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_OWNER=your_github_org
GITHUB_REPO=your_repo_name
GITHUB_SERVICE_REPO=organization/infra-devex
# Optional override; defaults to GITHUB_SERVICE_REPO when blank
GITHUB_SELF_SERVICE_REPO=
GITHUB_MODULES_REPO=organization/terraform-modules
GITHUB_INFRA_LIVE_REPO=organization/infrastructure-live
GITHUB_PRIVATE_KEY_PATH=
SERVICE_CATALOG_BRANCH=main

# Optional code deployment integration (separate GitHub App)
GITHUB_CODE_APP_ID=
GITHUB_CODE_INSTALLATION_ID=
GITHUB_CODE_PRIVATE_KEY_PATH=
GITHUB_CODE_SERVICE_REPO=organization/code-catalog
AKS_FLUX_REPO=organization/flux-config
AKS_DEFAULT_REGISTRY=
# Approved private-gateway DNS zones per environment, for example:
# AKS_PRIVATE_ZONES={"devsand":"private.example.com"}
AKS_PRIVATE_ZONES={}

# Webhook Configuration
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Entra ID Authentication (Azure AD)
# Get these values from Azure Portal > Entra ID > App Registrations
AZURE_AD_CLIENT_ID=your-application-client-id
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_SECRET=your-client-secret

# Frontend Entra ID Configuration (for MSAL.js)
# These can be the same as backend values
VITE_ENTRA_CLIENT_ID=your-application-client-id
VITE_ENTRA_TENANT_ID=your-tenant-id
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/your-tenant-id

# E2E Testing Credentials (Playwright with Entra ID)
# Create a dedicated test user in Entra ID for automated testing
# IMPORTANT: Never commit real credentials - keep this file as .env (gitignored)
E2E_TEST_USERNAME=e2e-test@yourdomain.com
E2E_TEST_PASSWORD=your-secure-test-password

# Testing Configuration
# For local E2E tests (optional - defaults to http://localhost:3001)
BASE_URL=http://localhost:3001

# For on-demand E2E tests against sand cluster
# Set this when running: npm run test:e2e:sand
SAND_CLUSTER_URL=https://self-service.example.com

# JIRA Integration (Change Management board)
# Create an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_CLOUD_ID=00000000-0000-0000-0000-000000000005
JIRA_USER_EMAIL=your-jira-account@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_SITE_URL=https://example.atlassian.net
# Only set JIRA_BASE_URL if you need to override the default Atlassian cloud endpoint
# JIRA_BASE_URL=

# ---------------------------------------------------------------------------
# Ship from Repo (docs/architecture/ship-from-repo-spec.md §4.5) - NO secrets here.
# Every default is fail-closed; leave unset until the matching human decision is recorded.
# ---------------------------------------------------------------------------
# Dedicated protected flux-config ref the ship workflow is dispatched on (H-5). If it equals AKS_FLUX_BRANCH the
# backend refuses to dispatch unless SHIP_ALLOW_DEFAULT_REF=true (recorded Security waiver).
# SHIP_WORKFLOW_REF=
# SHIP_ALLOW_DEFAULT_REF=false
# Comma-separated GitHub orgs users may ship from (H-7). Empty = nobody can ship.
# SHIP_ALLOWED_ORGS=
# Defaults to AKS_DEFAULT_REGISTRY (single shared registry, H-10).
# SHIP_REGISTRY=
# Platform team membership (H-4): Entra app roles and/or group object IDs. Empty = nobody qualifies.
# SHIP_PLATFORM_ROLES=
# SHIP_PLATFORM_GROUP_IDS=
# Identity provider (H-2). Only `none` exists today: every ship fails closed with REPO_NOT_ACCESSIBLE / IDENTITY_NOT_LINKED.
SHIP_IDENTITY_PROVIDER=none
# Preview host per env (H-1), JSON: {"devsand":{"suffix":"<cluster dns suffix>","scheme":"<http|https>"}}. No default.
# SHIP_PREVIEW_HOSTS=
# ACR source-label ownership read (H-3). Not implemented yet - leave false.
SHIP_ACR_READ_ENABLED=false
# Abuse limits (per replica) and windows
# SHIP_MAX_STARTS_PER_HOUR=12
# SHIP_MAX_ACTIVE_GLOBAL=10
# SHIP_MAX_ACTIVE_PER_USER=3
# SHIP_MAX_STARTS_PER_USER_PER_HOUR=6
# SHIP_RATE_LIMIT_GUARD_REMAINING=1000
# SHIP_RETRY_WINDOW_HOURS=24
# SHIP_RETENTION_DAYS=90
# Extra reserved namespaces on top of kube-*, flux-*, default, cert-manager, ingress-nginx (comma-separated; trailing * = prefix).
# SHIP_RESERVED_NAMESPACES=
# SHIP_SUPPORTED_LANGUAGES=Node.js,Python,Java,Go,.NET,Ruby,PHP
# Verification gates: do NOT set true until the gate PASS is recorded in the runbook.
#   V-3 = trusted ship.result annotations readable by the Infrastructure App
#   V-4 = queue/concurrency semantics (watchdog report, SUPERSEDED, queuedBehind)
SHIP_GATE_V3_PASSED=false
SHIP_GATE_V4_PASSED=false
# Cancel side effect of the queue watchdog; only effective when SHIP_GATE_V4_PASSED=true.
SHIP_WATCHDOG_CANCEL_ENABLED=false
