# Production Environment Configuration Template
# Copy this file to .env.production and fill in actual values
# DO NOT commit .env.production to version control

# =============================================================================
# API Configuration
# =============================================================================
VITE_API_BASE_URL=https://self-service.example.com/api
NODE_ENV=production

# =============================================================================
# GitHub App Configuration (Infrastructure)
# =============================================================================
GITHUB_APP_ID=your_infrastructure_app_id
GITHUB_INSTALLATION_ID=your_infrastructure_installation_id
GITHUB_PRIVATE_KEY_PATH=/app/secrets/github-infra-key.pem
# OR use inline key (base64 encoded):
# GITHUB_PRIVATE_KEY=your_base64_encoded_private_key

# =============================================================================
# GitHub App Configuration (Code Deployment)
# =============================================================================
GITHUB_CODE_APP_ID=your_code_deployment_app_id
GITHUB_CODE_INSTALLATION_ID=your_code_installation_id
GITHUB_CODE_PRIVATE_KEY_PATH=/app/secrets/github-code-key.pem
# OR use inline key (base64 encoded):
# GITHUB_CODE_PRIVATE_KEY=your_base64_encoded_private_key

# =============================================================================
# Azure Subscription Configuration
# =============================================================================
AZURE_SUBSCRIPTION_IDS='{"devsand":"00000000-0000-0000-0000-000000000001","sand":"00000000-xxxx-xxxx-xxxx-xxxxxxxxxxxx"}'
AZURE_DEFAULT_SUBSCRIPTION=00000000-0000-0000-0000-000000000001

# =============================================================================
# SOPS Secret Self-Service Encryption
# =============================================================================
# Shared platform Key Vault containing the SOPS encryption key.
SOPS_KEYVAULT_URL=https://<shared-platform-kv>.vault.azure.net
SOPS_KEY_NAME=self-service-infra-sops-master-key
SOPS_KEY_VERSION=<key-version>

# =============================================================================
# Repository Configuration
# =============================================================================
GITHUB_SERVICE_REPO=organization/service-catalog
GITHUB_MODULES_REPO=organization/terraform-modules
AKS_FLUX_REPO=organization/flux-config

# =============================================================================
# Webhook Configuration
# =============================================================================
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# Application Configuration
# =============================================================================
PORT=3000
LOG_LEVEL=info

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
ENABLE_DEBUG_MODE=false
ENABLE_EXPERIMENTAL_FEATURES=false
