# Server Configuration
PORT=3000
NODE_ENV=production

# GitHub Configuration
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_TOKEN=your_github_token_here
GITHUB_PRIVATE_KEY_PATH=/app/secrets/github-private-key.pem

# Azure Configuration
AZURE_SUBSCRIPTION_IDS={"devsand":"00000000-0000-0000-0000-000000000001","sand":"00000000-0000-0000-0000-000000000002"}
AZURE_DEFAULT_SUBSCRIPTION=00000000-0000-0000-0000-000000000001

# SOPS secret self-service encryption
SOPS_KEYVAULT_URL=https://<shared-platform-kv>.vault.azure.net
SOPS_KEY_NAME=self-service-infra-sops-master-key
