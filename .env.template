# Server Configuration
PORT=3000
NODE_ENV=production

# GitHub Configuration
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_TOKEN=your_github_token_here
GITHUB_PRIVATE_KEY_PATH=/app/secrets/github-private-key.pem

# Azure Configuration
AZURE_SUBSCRIPTION_IDS={"devsand":"11844065-4a70-473d-a17c-9c2b636fc250","sand":"552bdc54-0a39-4040-9d8f-4002e8f572aa"}
AZURE_DEFAULT_SUBSCRIPTION=11844065-4a70-473d-a17c-9c2b636fc250

# SOPS secret self-service encryption
SOPS_KEYVAULT_URL=https://<shared-platform-kv>.vault.azure.net
SOPS_KEY_NAME=self-service-infra-sops-master-key
SOPS_KEY_VERSION=<key-version>

# ---------------------------------------------------------------------------
# Ship from Repo (docs/architecture/ship-from-repo-spec.md §4.5) - NO secrets here.
# Every default is fail-closed; leave unset until the matching human decision is recorded.
# ---------------------------------------------------------------------------
# Dedicated protected aya-flux ref the ship workflow is dispatched on (H-5). If it equals AKS_FLUX_BRANCH the
# backend refuses to dispatch unless SHIP_ALLOW_DEFAULT_REF=true (recorded Security waiver).
# SHIP_WORKFLOW_REF=
# SHIP_ALLOW_DEFAULT_REF=false
# Comma-separated GitHub orgs users may ship from (H-7). Empty = nobody can ship.
# SHIP_ALLOWED_ORGS=
# Defaults to AKS_DEFAULT_REGISTRY (single shared registry, H-10).
# SHIP_REGISTRY=
# Platform team membership (H-4): Entra app roles and/or group object IDs. Empty = nobody qualifies.
# SHIP_PLATFORM_ROLES=
# SHIP_PLATFORM_GROUP_IDS=
# Identity provider (H-2). Only `none` exists today: every ship fails closed with REPO_NOT_ACCESSIBLE / IDENTITY_NOT_LINKED.
SHIP_IDENTITY_PROVIDER=none
# Preview host per env (H-1), JSON: {"devsand":{"suffix":"<cluster dns suffix>","scheme":"<http|https>"}}. No default.
# SHIP_PREVIEW_HOSTS=
# ACR source-label ownership read (H-3). Not implemented yet - leave false.
SHIP_ACR_READ_ENABLED=false
# Abuse limits (per replica) and windows
# SHIP_MAX_STARTS_PER_HOUR=12
# SHIP_MAX_ACTIVE_GLOBAL=10
# SHIP_MAX_ACTIVE_PER_USER=3
# SHIP_MAX_STARTS_PER_USER_PER_HOUR=6
# SHIP_RATE_LIMIT_GUARD_REMAINING=1000
# SHIP_RETRY_WINDOW_HOURS=24
# SHIP_RETENTION_DAYS=90
# Extra reserved namespaces on top of kube-*, flux-*, default, cert-manager, ingress-nginx (comma-separated; trailing * = prefix).
# SHIP_RESERVED_NAMESPACES=
# SHIP_SUPPORTED_LANGUAGES=Node.js,Python,Java,Go,.NET,Ruby,PHP
# Verification gates: do NOT set true until the gate PASS is recorded in the runbook.
#   V-3 = trusted ship.result annotations readable by the Infrastructure App
#   V-4 = queue/concurrency semantics (watchdog report, SUPERSEDED, queuedBehind)
SHIP_GATE_V3_PASSED=false
SHIP_GATE_V4_PASSED=false
# Cancel side effect of the queue watchdog; only effective when SHIP_GATE_V4_PASSED=true.
SHIP_WATCHDOG_CANCEL_ENABLED=false
