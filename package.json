{
  "name": "self-service-infrastructure-catalog",
  "version": "2.0.0",
  "description": "Self-service interface for provisioning, deploying, and deleting infrastructure using standardized Terraform modules",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:client": "vite",
    "build:client": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "check:public-source": "node scripts/check-public-source.mjs",
    "build": "npm run build:client",
    "test": "vitest run --project jsdom",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --project jsdom --coverage",
    "test:smoke": "vitest run --project node tests/smoke",
    "test:integration": "vitest run --project node tests/integration",
    "test:watch": "vitest"
  },
  "keywords": [
    "infrastructure",
    "terraform",
    "self-service",
    "github-app"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/identity": "^4.10.0",
    "@azure/msal-browser": "^5.2.0",
    "@azure/msal-node": "^7.2.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.13.6",
    "body-parser": "^2.4.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dd-trace": "^6.24.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.0.1",
    "hcl2-parser": "^1.0.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "morgan": "^1.10.1",
    "octokit": "^5.0.5",
    "tweetnacl": "^1.0.3",
    "tweetnacl-sealedbox-js": "^1.2.0",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^11.1.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.24",
    "jsdom": "^31.0.0",
    "nodemon": "^3.0.1",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.27",
    "vue-tsc": "^3.2.2"
  },
  "overrides": {
    "qs": "^6.14.2",
    "uuid": "^11.1.1"
  }
}
